# Copy to .env; keys are read by Python services only.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8790
# Required (32+ characters) for APP_ENV=production. Enter this in web Settings.
APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8790,http://127.0.0.1:8790

# LiveKit self-hosted dev or LiveKit Cloud.
LIVEKIT_URL=ws://127.0.0.1:7880
# Optional internal address for worker/API in Docker; browser keeps LIVEKIT_URL.
LIVEKIT_SERVER_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_AGENT_NAME=portrait-voice
SESSION_MAX_SECONDS=1800

# Reference project uses Soniox, not Cartesia Sonic.
SONIOX_API_KEY=
SONIOX_STT_MODEL=stt-rt-v4
SONIOX_LANGUAGE_HINTS=vi,en
SONIOX_MAX_ENDPOINT_DELAY_MS=1000
SONIOX_TTS_MODEL=tts-rt-v1-preview
SONIOX_TTS_VOICE=Nina
SONIOX_TTS_LANGUAGE=vi
SONIOX_TTS_SPEED=0.95

# gemini | openai | local (OpenAI-compatible Ollama/vLLM/LM Studio)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_ALLOW_NO_KEY=false
LLM_TEMPERATURE=0.4

AGENT_PROMPT_FILE=prompts/system.md
AGENT_GREETING=Chào bạn, mình đây! Hôm nay bạn muốn tâm sự hay nghe một chuyện vui?
AGENT_TIMEZONE=Asia/Ho_Chi_Minh
# Uses GEMINI_API_KEY. Search runs only when the assistant needs current web information.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MODEL=gemini-2.5-flash
